{
  "name": "larshansen",
  "version": "1.0.0",
  "private": true,
  "description": "Lars Hansen — personal monorepo. Platform-game landing page plus apps.",
  "homepage": "https://larshansen.dev",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "bun run --filter '@larshansen/landing' dev",
    "dev:portfolio": "bun run --filter '@larshansen/portfolio' dev",
    "dev:iron-maze": "bun run --filter '@larshansen/iron-maze' dev",
    "build": "bun run --filter '*' build",
    "build:landing": "bun run --filter '@larshansen/landing' build",
    "build:portfolio": "bun run --filter '@larshansen/portfolio' build",
    "build:iron-maze": "bun run --filter '@larshansen/iron-maze' build"
  },
  "license": "MIT"
}
